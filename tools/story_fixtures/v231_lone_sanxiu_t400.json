0","cls":""},{"t":"第1731年","text":"《敛息术》熟练升至「小成」","cls":"jade"},{"t":"第1731年","text":"与墨无痕结为知己：寿元 ×1.1","cls":"gold"},{"t":"第1731年","text":"得到灵宝兵器【诛邪剑】（会心、轻灵、蓄势）","cls":"gold"},{"t":"第1731年","text":"得到仙品饰品【不老松枝】（护主、疾行、先声）","cls":"gold"},{"t":"第1731年","text":"得到灵宝兵器【诛邪剑】（引爆、破罩）","cls":"gold"},{"t":"第1731年","text":"【九幽魔渊·禁地】寻宝归来，评价「天」，灵石+13.3万","cls":"gold"},{"t":"第1711年","text":"得到仙品饰品【鸿蒙道珠】（先声、养气）","cls":"gold"},{"t":"第1711年","text":"【血池垂钓】身后一声水响，然后安静了。血无涯笑：“我就说，咱们是一路人。”","cls":"jade"},{"t":"第1711年","text":"记下一笔因果：血池边的正道弟子（看着他被血无涯钓走）","cls":"red"},{"t":"第1691年","text":"坊市拍卖会开槌，为期 6 月","cls":"gold"},{"t":"第1671年","text":"御剑出发，前往【九幽魔渊·禁地】寻宝","cls":""},{"t":"第1631年","text":"【游方丹师】游方丹师路过洞府，临走时在桌上留下一枚破境丹。","cls":"jade"},{"t":"第1611年","text":"从剑气秘境第 5 层全身而退，带回 0 件收获","cls":"jade"},{"t":"第1611年","text":"【未熄的祭坛】指尖刚碰到剑柄，葫芦里泼出一道酒线，在你胸口烫出个“贼”字。三天才消。","cls":"red"},{"t":"第1611年","text":"【生死门】“生”门后一汪泉水泛着微光。换字的人大概是好心，也可能只是手滑。","cls":"jade"},{"t":"第1611年","text":"踏入剑气秘境（8 层，气血 135）","cls":"gold"},{"t":"第1611年","text":"出关！修为 +117万，顿悟再得 51.2万","cls":"gold"},{"t":"第1611年","text":"入夏，剑气秘境开了（6 月），送来一枚秘境令","cls":"gold"},{"t":"第1591年","text":"得到仙品饰品【天机罗盘】（镇劫）","cls":"gold"},{"t":"第1591年","text":"聚灵阵布成：修炼 ×4.32","cls":"gold"},{"t":"第1571年","text":"丹成！上品淬体丹：永久战力 +1%","cls":"jade"},{"t":"第1571年","text":"天下大势：【矿脉现世】，8 个月——上古剑冢灵矿 ×3","cls":"gold"},{"t":"第1551年","text":"得到仙品饰品【不老松枝】（先声、养伤）","cls":"gold"}],"rebirth":1,"lives":[],"flags":{"spentAt":398,"maxI":25,"readyNotified":0,"warnLife":0,"retStreak":1,"dingStreak":null,"retFree":1,"genCombo":1,"guardUsed":1,"maxR":6,"inviteAt":403,"petFirst":1,"trib1":1,"war":410},"seenTips":{},"origin":"sanxiu","meta":{"aff":{"0":1,"2":1,"3":1,"4":1,"5":1,"6":1,"7":1,"8":1,"9":1,"10":1,"11":1,"12":1,"13":1,"14":1,"15":1,"17":1,"18":1,"19":1,"20":1},"perk":{},"seen":{},"elem":{"0":1,"1":1,"2":1,"3":1,"4":1,"5":1,"6":1,"rv_mu":1,"boss_1":1,"rv_zhao":1,"boss_2":1,"boss_3":1,"boss_4":1,"rv_chu":1,"boss_5":1,"boss_6":1},"combo":{"c1":1,"c5":1,"c15":1,"c10":1},"c