[configuration]
entry_symbol = "xianmen_runtime_init"
compatibility_minimum = "4.5"

[libraries]
macos.arm64 = "res://addons/xianmen_runtime/bin/libxianmen.macos.template_debug.arm64.dylib"
macos.x86_64 = "res://addons/xianmen_runtime/bin/libxianmen.macos.template_debug.x86_64.dylib"
linux.arm64 = "res://addons/xianmen_runtime/bin/libxianmen.linux.template_debug.arm64.so"
linux.x86_64 = "res://addons/xianmen_runtime/bin/libxianmen.linux.template_debug.x86_64.so"
android.debug.arm64 = "res://addons/xianmen_runtime/bin/libxianmen.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/xianmen_runtime/bin/libxianmen.android.template_release.arm64.so"
